{
  "name": "svws-prognos",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "electron:dev": "npm run build && GSETTINGS_SCHEMA_DIR=$HOME/.local/share/electron-schemas electron . --no-sandbox --ozone-platform=x11",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win nsis",
    "release": "rm -rf release && npm run build && electron-builder --linux AppImage --win nsis; mkdir -p release && cd dist && zip -r ../release/SVWS-Prognos-$npm_package_version-webserver.zip ."
  },
  "build": {
    "appId": "de.skinwalker.svws-prognos",
    "productName": "SVWS Prognos",
    "artifactName": "SVWS-Prognos-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "@ag-grid-community/client-side-row-model": "^32.3.0",
    "@ag-grid-community/core": "^32.3.0",
    "@ag-grid-community/styles": "^32.3.9",
    "@ag-grid-community/vue3": "^32.3.0",
    "@primevue/themes": "^4.5.4",
    "axios": "^1.8.0",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "pinia": "^3.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^42.3.1",
    "electron-builder": "^26.8.1",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
